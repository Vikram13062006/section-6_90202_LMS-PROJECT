# Backend runtime profile
APP_PROFILE=mysql

# Render provides PORT automatically; keep this for local runs if needed
PORT=8080

# MySQL connection
MYSQL_URL=jdbc:mysql://localhost:3306/lms_db
MYSQL_USER=root
MYSQL_PASSWORD=

# JWT secret must be long (>= 32 chars)
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed CORS origins/patterns
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,https://*.onrender.com,https://*.netlify.app

# Upload storage path (Render filesystem is ephemeral)
APP_UPLOAD_DIR=uploads
